# CRM lead endpoint (Power Automate HTTP trigger) used by src/api/refillsApi.ts's
# sendTaskToOmni — each "Send Task to Omni" creates the chp_omnitasks record and
# POSTs it here as a lead. The "sig" query parameter is a secret key.
VITE_CRM_LEAD_URL=https://<crm-endpoint>/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=<signature>

# Dataverse environment that holds the app data (patients, prescriptions, omni tasks, ...).
# The code app may be deployed to a different environment; src/api/dataverseClient.ts
# reads and writes this one explicitly. Defaults to DT New when unset.
VITE_DATAVERSE_ORG_URL=https://org319b4ea9.crm4.dynamics.com
